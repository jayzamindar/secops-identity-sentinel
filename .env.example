# ==============================================================================
# secops-identity-sentinel — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this template to '.env' and populate with your environment-specific credentials.
# NEVER commit the active '.env' file or any real secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Primary AI Engine (Google Gemini 3.8 Flash High)
# ------------------------------------------------------------------------------
# Google AI Studio or Vertex AI API Key for Tier 1 cognitive triage.
GEMINI_API_KEY=your_gemini_api_key_here

# Primary model identifier (dynamically loaded, never hardcoded).
GEMINI_MODEL_NAME=gemini-3.8-flash-high

# Thinking budget allocation for Gemini dynamic thinking models (default: 2048 tokens).
GEMINI_THINKING_BUDGET=2048

# Maximum response output tokens per generation request (hard ceiling: 8192).
MAX_OUTPUT_TOKENS=8192

# Maximum request body size ceiling in bytes (10MB = 10485760 bytes; HTTP 413 on breach).
MAX_PAYLOAD_SIZE_BYTES=10485760

# Maximum cumulative token budget per triage session before triggering circuit breaker.
MAX_SESSION_TOKEN_BUDGET=500000

# Daily cumulative API cost limit in USD before tripping circuit breaker to Tier 3 heuristics.
DAILY_API_COST_LIMIT_USD=10.00

# ------------------------------------------------------------------------------
# Secondary Fallback Engine (OpenRouter / OpenAI-Compatible)
# ------------------------------------------------------------------------------
# API Key for Tier 2 fallback reasoning (e.g., Qwen 2.5 Coder 32B).
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# Authentication & Cryptographic Signing Secrets
# ------------------------------------------------------------------------------
# API key required for MCP JSON-RPC, SSE (/v1/sse), and HTTP API authentication.
MCP_API_KEY=change_me_strong_mcp_api_key

# Secret key used for HMAC-SHA256 signing of all remediation plans and state mutations.
# In 'production' environment, failure to set a strong custom secret fails closed.
PLAN_SIGNING_SECRET=change_me_strong_hmac_signing_secret

# Shared secret for validating incoming SIEM / IdP webhook signatures.
SECOPS_IDENTITY_SENTINEL_WEBHOOK_SECRET=change_me_strong_webhook_secret

# ------------------------------------------------------------------------------
# Runtime Environment & Gateway Controls
# ------------------------------------------------------------------------------
# Deployment environment: 'development', 'staging', or 'production'.
ENVIRONMENT=development

# Enforce strict authentication across all HTTP and SSE endpoints (true/false).
REQUIRE_AUTH=true

# Service listening port for FastAPI / Uvicorn gateway (default: 8080).
PORT=8080

# ------------------------------------------------------------------------------
# Persistence & Concurrency Isolation (SQLite WAL Mode)
# ------------------------------------------------------------------------------
# Path to persistent SQLite ledger database file.
DB_PATH=data/secops_ledger.db

# Cross-platform filelock timeout in seconds for write transactions (default: 10.0s).
FILELOCK_TIMEOUT_SEC=10.0

# ------------------------------------------------------------------------------
# Audit Logging & SIEM Retention
# ------------------------------------------------------------------------------
# Directory for rotated structured JSONL audit logs.
AUDIT_LOG_DIR=audit_logs

# Retention window for rotated JSONL audit files in days (default: 30 days).
AUDIT_LOG_MAX_RETENTION_DAYS=30

# Maximum cumulative size of the audit log directory in megabytes before pruning (default: 500MB).
AUDIT_LOG_MAX_SIZE_MB=500
