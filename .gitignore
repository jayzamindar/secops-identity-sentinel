# ==============================================================================
# Autonomous SecOps & Identity Incident Responder (secops-identity-sentinel) — .gitignore
# ==============================================================================

# Python Runtime, Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Secrets & Environment Configurations
.env
.env.*
!.env.example
*.pem
*.key

# Packaging & Build Distribution
dist/
build/
*.egg-info/
*.egg

# Testing, Static Typing & Linting Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Persistence, Databases, Storage & Audit Logs
data/
*.db
*.db-wal
*.db-shm
audit_logs/
*.log

# OS & IDE Metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
